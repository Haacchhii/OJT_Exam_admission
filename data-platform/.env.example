# Local-only data-platform configuration. Copy to .env and change the values.
# Never reuse application or Supabase production credentials here.

DATA_PLATFORM_ENV=development
SOURCE_DATABASE_URL=postgresql://goldenkey_reader:local-source-password@source-db:5432/goldenkey_source
WAREHOUSE_DATABASE_URL=postgresql://goldenkey_warehouse:local-warehouse-password@warehouse-db:5432/goldenkey_warehouse
OBJECT_STORAGE_ENDPOINT=http://seaweedfs:8333
OBJECT_STORAGE_ACCESS_KEY=local-seaweedfs-user
OBJECT_STORAGE_SECRET_KEY=local-seaweedfs-password
OBJECT_STORAGE_BUCKET=goldenkey-raw
PIPELINE_BATCH_SIZE=1000
PIPELINE_LOOKBACK_MINUTES=5

# Docker Compose service initialization. These are local placeholders only.
SOURCE_DB_OWNER_USER=goldenkey_source_owner
SOURCE_DB_OWNER_PASSWORD=local-source-owner-password
SOURCE_DB_NAME=goldenkey_source
WAREHOUSE_DB_USER=goldenkey_warehouse
WAREHOUSE_DB_PASSWORD=local-warehouse-password
WAREHOUSE_DB_NAME=goldenkey_warehouse
